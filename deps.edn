         ;; moving a check to make a test green.
         ;;
         ;; Both pins are also behind kotoba-native main (155e82ce): this one
         ;; by 34, amu's by 2.
         :git/sha "adeb1b0fa5bcd2dd18a657c7e3bd3c4acbd630ae"}
        io.github.kotoba-lang/kotoba-wasm
