{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; This pin is read by `kotoba.verifier-kir-agreement-test`, which
        ;; compares this repo's native float admission list against
        ;; `kotoba.kir/native-floating-point-operations`. It is compared, not
        ;; imported: the verifier still derives its own set, because being
        ;; stricter than the oracle is sound and being looser is not. 6b459e2
        ;; is the commit that exports that list.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "6b459e2ca72f3b3851a3121dd583066969aba998"}
        io.github.kotoba-lang/artifact
        {:git/url "https://github.com/kotoba-lang/artifact.git"
         :git/sha "ba29522ece748d2f7ff420d2ba45b1126c94baf8"}
        ;; This repo does not merely depend on the backend, it CALLS it --
        ;; `native-targets` above holds `x86-64/emit-program` -- so admitting a
        ;; shape while pinned to a backend that refuses or miscompiles it would
        ;; put the disagreement inside this repo's own closure.
        ;;
        ;; This pin contains scalar replacement for fixed scalar records and
        ;; variants, aggregate ABI v7 recursive record and variant payload
        ;; handles, sealed callable dispatch, and closed linkage evidence,
        ;; liveness-minimal scalar calls,
        ;; parallel function entry, and bounded lazy entry spills. It also
        ;; carries the word/f64, bounded-memory, runtime/capability-call,
        ;; composite-value, immutable-data, and x86 privileged migrations.
        ;; Flat and nested records plus i64/bool variants use checked pair
        ;; boundaries; unsupported aggregate shapes fail closed.
        ;; Verification therefore re-emits with the exact producer
        ;; implementation whose KIR slice is admitted here.
        ;; boot-lit: kotoba-gmir is named at the TOP LEVEL rather than taken
        ;; through kotoba-native, and the reason is a measurement. This file
        ;; needs `gmir/rodata-content?` -- the single decoder for a read-only
        ;; literal, because re-deriving the GUID grammar here would be a second
        ;; thing that has to agree about what a literal is. Bumping the
        ;; kotoba-native pin to reach it instead imports 22 failures in
        ;; `pinned-producer-*`, which pin allocator output shapes across an
        ;; allocator change this stream does not own (measured 2026-09-02:
        ;; main is 67/425/0, the same suite at kotoba-native fdd580e is
        ;; 67/429/30). A top-level git dependency wins over a transitive one,
        ;; so this reaches the decoder without moving the backend.
        io.github.kotoba-lang/kotoba-gmir
        {:git/url "https://github.com/kotoba-lang/kotoba-gmir.git"
         :git/sha "fe238166e932c29700f3f447701e1f9893aedce1"}
        io.github.kotoba-lang/kotoba-native
        {:git/url "https://github.com/kotoba-lang/kotoba-native.git"
         :git/sha "a2023fed59208b0b4f48795d6e688f5cbd1aad8e"}
        io.github.kotoba-lang/kotoba-wasm
        {:git/url "https://github.com/kotoba-lang/kotoba-wasm.git"
         :git/sha "9f988676859d55d709a95b025d3f5a80b3743826"}
        io.github.kotoba-lang/kotoba-component
        {:git/url "https://github.com/kotoba-lang/kotoba-component.git"
         :git/sha "a9d4727821d84b4bef11fa6ff0a68bcc617cd3b8"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
