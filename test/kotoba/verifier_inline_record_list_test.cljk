(ns kotoba.verifier-inline-record-list-test
  "A `[:list <record>]` spelled with the record inline (the compile cache's OutputEntry
  list) holds one-word record handles like `[:list [:ref q]]`; projecting the schema it
  was declared with verifies, projecting any other schema through it is rejected."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.verifier]))

(def ^:private entry '[:record :t/entry [[:path :string] [:n :i64]]])
(def ^:private other '[:record :t/other [[:path :string] [:n :i64]]])
(def ^:private entries (list :list entry))

(defn- program [projected]
  {:format :kotoba.kir/v4 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'second-n :params ['es] :param-types [(vec entries)] :result :i64 :effects #{}
                :body (list 'record-get projected (list 'typed-list-nth (vec entries) 'es 1) :n)}
               {:name 'main :params [] :param-types [] :result :i64 :effects #{}
                :body (list 'second-n (list 'typed-list-new (vec entries)
                                            (list 'record-new entry "a" 1)
                                            (list 'record-new entry "b" 2)))}]})

(defn- rejection [program]
  (try (#'kotoba.verifier/verify-program! program)
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(deftest projecting-the-declared-schema-through-an-inline-record-list-verifies
  (is (nil? (rejection (program entry)))))

(deftest projecting-another-schema-through-it-is-rejected
  (is (= "runtime KIR record projection rejected" (rejection (program other)))))
